# Postgres connection string (Railway provides this automatically as DATABASE_URL
# when you attach a Postgres plugin to this service — see README.md for setup).
DATABASE_URL="postgresql://user:password@localhost:5432/mcc_training"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Credentials for the first admin account, created by `npm run db:seed`.
ADMIN_EMAIL="shar@mamascleaningcrew.com"
ADMIN_NAME="Shar"
ADMIN_PASSWORD="change-this-immediately"

# Zoom info included in phone-interview calendar invites/confirmation emails
# sent to applicants. Use your Personal Meeting ID (numbers only — spaces/
# dashes are stripped automatically) if you always meet at the same Zoom
# link, or set RECRUITING_ZOOM_LINK to a full URL instead (PMI takes
# priority if both are set). RECRUITING_ZOOM_PASSCODE is optional but
# needed if your Zoom account requires one to join.
RECRUITING_ZOOM_PMI="123 456 7890"
RECRUITING_ZOOM_LINK=""
RECRUITING_ZOOM_PASSCODE=""

# QuickBooks Online — lets the owner pull top-line P&L numbers into
# Financials instead of retyping them from QuickBooks by hand. Create a
# free app at developer.intuit.com ("Create an app" → QuickBooks Online
# and Payments), then copy the Client ID/Secret from its Keys & OAuth
# page. Add {NEXT_PUBLIC_APP_URL}/api/quickbooks/callback as a Redirect
# URI there. Use the Development keys against a Sandbox company first —
# only switch QUICKBOOKS_ENVIRONMENT to "production" (and swap in the
# Production keys) once the whole connect flow has been proven safe.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="sandbox"

# AI Assistant (/assistant, ADMIN only) — answers questions about the
# business by looking up real financials/sales/HR/checklist data, then
# asking Claude to summarize it. Get a key at console.anthropic.com
# (Settings → API Keys). This is billed separately from any Claude.ai
# subscription — it's pay-as-you-go API usage.
ANTHROPIC_API_KEY=""

# Sales mailbox used as the From/Reply-To/BCC on every quote email a rep
# sends from the pricing tool, so Accept/Decline replies and the internal
# thread always land in the same shared inbox regardless of which rep sent
# it. Reply-To is forced to this value server-side — it is never read from
# the quote itself — so leave this unset (or set to the real shared
# mailbox) rather than something a client might reply into and lose.
# Defaults to sales@mamascleaningcrew.com if unset.
SALES_SENDER_EMAIL=""

# Error monitoring (Sentry) — surfaces real errors from the live app
# instead of only ever showing up in Railway's logs. Free at reasonable
# volume for a small app. Create a free account at sentry.io, make a
# Next.js project, and copy its DSN from Settings -> Client Keys (DSN).
# The DSN isn't a secret (it's meant to be public, like a publishable
# key) — that's why it's NEXT_PUBLIC_. Leave blank to disable entirely.
NEXT_PUBLIC_SENTRY_DSN=""

# ── Microsoft Graph — email sending + the interview calendar ──
# Required for every candidate/staff email (sendEmail) and for creating
# interview calendar events (createCalendarEvent). Create an Entra ID app
# registration with Mail.Send and Calendars.ReadWrite application
# permissions (admin-consented), then set these from it.
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
# The mailbox email actually sends from (and the default notify-email
# fallback below) — a real, licensed mailbox, not a shared one.
MS_GRAPH_SENDER_EMAIL=""
# The mailbox whose calendar interview events are created on — this is the
# "interview calendar mailbox" referenced elsewhere (keep this as
# sharifaq@mamascleaningcrew.com in production; changing it moves where
# every interview shows up on a calendar).
RECRUITING_CALENDAR_MAILBOX=""

# ── RingCentral — SMS/text sending ──
# Required for every candidate text (sendSms): interview invites, interview
# confirmations/reminders, and reschedule confirmations. A JWT-auth
# RingCentral app (not OAuth) — create one in the RingCentral Developer
# Console and generate a JWT credential for it.
RINGCENTRAL_CLIENT_ID=""
RINGCENTRAL_CLIENT_SECRET=""
RINGCENTRAL_JWT=""
RINGCENTRAL_FROM_NUMBER=""
# Defaults to RingCentral's production API if unset — only needed for a
# sandbox app during setup/testing.
RINGCENTRAL_SERVER_URL=""

# ── Staff notification routing ──
# Where internal notifications about applicants (new applicant, candidate
# booked/rescheduled/can't-make-it their own interview) are sent. Falls back
# to MS_GRAPH_SENDER_EMAIL if unset — set this explicitly to
# info@mamascleaningcrew.com in production so these land in the shared
# Info inbox rather than whichever mailbox email happens to send from.
RECRUITING_NOTIFY_EMAIL=""
# Where internal notifications about new leads are sent (separate from the
# applicant notifications above). Falls back to MS_GRAPH_SENDER_EMAIL if
# unset — set this explicitly to sales@mamascleaningcrew.com in production.
SALES_NOTIFY_EMAIL=""

# ── Slack — real-time staff notifications ──
# Optional; both silently no-op if unset; nothing here blocks a booking/
# reschedule on their own account's setup.
SLACK_BOT_TOKEN=""
# Only needed for channel-wide posts (e.g. the weekly update digest) — not
# required for the owner DM below.
SLACK_TEAM_CHANNEL_ID=""
# A DM to this Slack user id goes out for new applicants, and for a
# candidate booking/rescheduling/declining their own interview.
OWNER_SLACK_USER_ID=""

# Payroll "review & sign your hours" reminder emails (the recurring nag to
# employees with a PENDING payroll entry — not the owner's emailed Excel
# payroll reports or the signed-file reply flow, both unaffected by this).
# Paused by default, and by anything other than the literal string "true"
# — employees don't have dashboard access yet, so the reminder's link to
# /payroll is a dead end for them. Only set to "true" once employee
# rollout is explicitly approved and dashboard access is confirmed working.
PAYROLL_REMINDER_EMAILS_ENABLED="false"
