# Postgres connection string (Railway provides this automatically as DATABASE_URL
# when you attach a Postgres plugin to this service — see README.md for setup).
DATABASE_URL="postgresql://user:password@localhost:5432/mcc_training"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Credentials for the first admin account, created by `npm run db:seed`.
ADMIN_EMAIL="shar@mamascleaningcrew.com"
ADMIN_NAME="Shar"
ADMIN_PASSWORD="change-this-immediately"

# Zoom info included in phone-interview calendar invites/confirmation emails
# sent to applicants. Use your Personal Meeting ID (numbers only — spaces/
# dashes are stripped automatically) if you always meet at the same Zoom
# link, or set RECRUITING_ZOOM_LINK to a full URL instead (PMI takes
# priority if both are set). RECRUITING_ZOOM_PASSCODE is optional but
# needed if your Zoom account requires one to join.
RECRUITING_ZOOM_PMI="123 456 7890"
RECRUITING_ZOOM_LINK=""
RECRUITING_ZOOM_PASSCODE=""

# QuickBooks Online — lets the owner pull top-line P&L numbers into
# Financials instead of retyping them from QuickBooks by hand. Create a
# free app at developer.intuit.com ("Create an app" → QuickBooks Online
# and Payments), then copy the Client ID/Secret from its Keys & OAuth
# page. Add {NEXT_PUBLIC_APP_URL}/api/quickbooks/callback as a Redirect
# URI there. Use the Development keys against a Sandbox company first —
# only switch QUICKBOOKS_ENVIRONMENT to "production" (and swap in the
# Production keys) once the whole connect flow has been proven safe.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="sandbox"

# AI Assistant (/assistant, ADMIN only) — answers questions about the
# business by looking up real financials/sales/HR/checklist data, then
# asking Claude to summarize it. Get a key at console.anthropic.com
# (Settings → API Keys). This is billed separately from any Claude.ai
# subscription — it's pay-as-you-go API usage.
ANTHROPIC_API_KEY=""
