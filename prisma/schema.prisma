generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINEE
  ADMIN
  TRAINER
  SERVICE_MANAGER
}

// A "vertical" of the business. HR is where the training/onboarding portal
// (everything built so far) lives; the others are placeholders until those
// departments get real content built out.
enum Department {
  SALES
  HR
  OPERATIONS
  MANAGEMENT
}

enum Language {
  EN
  ES
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// The recruiting pipeline: Applied -> auto-scored prescreen -> phone/Zoom
// interview -> in-person interview -> offer (sent manually via Gusto) ->
// Hired. REJECTED and BENCH are manager-confirmed off-ramps from any stage.
enum ApplicantStage {
  NEW
  PRESCREEN_FAILED
  PRESCREEN_PASSED
  // Recruiting 2.0: Shar tapped "Invite to Interview" — a booking-link
  // email/text went out, but the candidate hasn't picked a slot yet. Once
  // they book (see InterviewAvailabilitySlot), the applicant moves to
  // IN_PERSON_SCHEDULED exactly like every other scheduled interview.
  INTERVIEW_INVITE_SENT
  PHONE_INTERVIEW_SCHEDULED
  PHONE_INTERVIEW_PASSED
  PHONE_INTERVIEW_FAILED
  IN_PERSON_SCHEDULED
  IN_PERSON_PASSED
  IN_PERSON_FAILED
  OFFER_SENT
  HIRED
  REJECTED
  BENCH
}

enum ApplicantSource {
  CAREERS_PAGE
  INDEED
  ZIPRECRUITER
  REFERRAL
  WALK_IN
  // Facebook/Instagram paid or organic traffic (Recruiting 2.0) — kept
  // distinct from the generic OTHER bucket now that MCC advertises there.
  META
  OTHER
}

// Tracks an employee's path from Trainee to certified Technician: a Trainer
// recommends once the 3-day field training is done, then a Manager/Admin
// makes the final call.
enum CertificationStatus {
  NOT_RECOMMENDED
  PENDING
  CERTIFIED
  DECLINED
}

model User {
  id               String    @id @default(cuid())
  // Human-facing identifier ("MCC-0001"), distinct from the internal cuid
  // `id` — assigned once at account creation from a Postgres sequence
  // (see the employee_id_seq migration), never reused or renumbered.
  employeeId       String?   @unique
  email            String    @unique
  name             String
  // Alternate "Cleaner" names from payroll report workbooks that HR has
  // manually attached to this employee (e.g. the scheduling platform has
  // her down with a middle name this account's `name` doesn't have) — the
  // payroll importer checks these before giving up on a name it can't
  // match to anyone.
  payrollAliasNames String[]  @default([])
  role             Role      @default(TRAINEE)
  passwordHash     String?
  mustSetPassword  Boolean   @default(true)
  active           Boolean   @default(true)
  // Seeded demo/test employee accounts (owner "View As" impersonation) —
  // never real staff, so they're excluded from staff directories, turnover
  // stats, CSV exports, and other real-business-data reporting.
  isTestAccount    Boolean   @default(false)
  inviteToken      String?   @unique
  inviteExpiresAt  DateTime?
  language         Language  @default(EN)
  lastLoginAt      DateTime?
  // When this person actually started working, not when their account was
  // created — used for years-of-service and upcoming-anniversary tracking
  // on the Staff dashboard. Backfilled from createdAt for existing users;
  // editable afterward since that's rarely their true start date.
  hireDate         DateTime?
  phone            String?
  address          String?
  employmentType   EmploymentType?
  // Free-text, not a fixed enum — a single-location business today, but
  // meant to grow into multiple physical locations/crew groupings without
  // a migration each time a new one is added.
  officeLocation   String?
  crewType         String?
  // Free-text name, not a relation to another User — MCC's roster includes
  // managers (e.g. the owner's own manager) who may not have an account in
  // this system at all, so this just records whatever name was on file.
  managerName      String?
  failedLoginAttempts Int    @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Departed is a distinct, HR-recorded roster status — not the same as a
  // plain `active=false` deactivation (which just revokes login access for
  // any reason). Marking someone departed also sets active=false; a rehire
  // clears these fields and reactivates the account.
  lastDay               DateTime?
  departureReason       String?   @db.Text
  departureRecordedById String?
  departureRecordedBy   User?     @relation("DepartureRecordedBy", fields: [departureRecordedById], references: [id], onDelete: SetNull)
  departuresRecorded    User[]    @relation("DepartureRecordedBy")
  // Null = not yet determined (the usual case right when someone is marked
  // departed, before an exit interview has happened) — distinct from false
  // (determined not eligible), so the two states aren't conflated.
  rehireEligible           Boolean?
  exitInterviewCompletedAt DateTime?
  exitInterviewNotes       String?   @db.Text

  progress       ModuleProgress[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  invitedBy    String?

  fieldEvaluationsReceived FieldEvaluation[] @relation("TraineeFieldEvaluations")
  fieldEvaluationsGiven    FieldEvaluation[] @relation("GradedFieldEvaluations")

  certificationStatus CertificationStatus @default(NOT_RECOMMENDED)
  certNotes           String?             @db.Text

  certRecommendedAt        DateTime?
  certRecommendedById      String?
  certRecommendedBy        User?     @relation("CertRecommendedBy", fields: [certRecommendedById], references: [id])
  certRecommendationsMade  User[]    @relation("CertRecommendedBy")

  certDecidedAt      DateTime?
  certDecidedById    String?
  certDecidedBy      User?     @relation("CertDecidedBy", fields: [certDecidedById], references: [id])
  certDecisionsMade  User[]    @relation("CertDecidedBy")

  departmentAccess DepartmentAccess[]
  sentCommunications CommunicationLog[]
  sentLeadCommunications LeadCommunication[]
  leadNotesWritten LeadNote[]
  leadStageChangesMade LeadStageChange[]
  assignedLeads Lead[] @relation("LeadAssignedTo")
  hiredFromApplicant Applicant? @relation("ApplicantHiredUser")
  applicantsViewed Applicant[] @relation("ApplicantViewedBy")
  onboardingAssignments OnboardingAssignment[]
  applicantNotesAuthored ApplicantNote[]
  phoneScreenResultsCompleted PhoneScreenResult[]
  interviewScorecards InterviewScorecard[]
  workingSessionsLed WorkingSessionRecord[]
  referenceChecksCompleted ReferenceCheck[]

  complaintsReceived Complaint[]       @relation("EmployeeComplaints")
  complaintsLogged   Complaint[]       @relation("ComplaintsLogged")
  attendanceEvents       AttendanceEvent[] @relation("EmployeeAttendanceEvents")
  attendanceEventsLogged AttendanceEvent[] @relation("AttendanceEventsLogged")
  payrollEntries     PayrollEntry[]    @relation("EmployeePayrollEntries")
  payrollOverridesRecorded PayrollEntry[] @relation("PayrollOverriddenBy")

  weeklyUpdatesCreated  WeeklyUpdate[] @relation("WeeklyUpdateCreatedBy")
  weeklyUpdatesApproved WeeklyUpdate[] @relation("WeeklyUpdateApprovedBy")

  pairsAsLead      Pair[] @relation("PairLead")
  pairsAsAssistant Pair[] @relation("PairAssistant")
  pairsCreated     Pair[] @relation("PairCreatedBy")

  trainingAssignmentsAsTrainer TrainingAssignment[] @relation("TrainingAssignmentTrainer")
  trainingAssignmentsAsTrainee TrainingAssignment[] @relation("TrainingAssignmentTrainee")
  trainingAssignmentsCreated   TrainingAssignment[] @relation("TrainingAssignmentCreatedBy")

  quickBooksConnectionsMade QuickBooksConnection[]

  promotionAssessments       PromotionAssessment[] @relation("PromotionAssessmentEmployee")
  promotionAssessmentsMade   PromotionAssessment[] @relation("PromotionAssessmentAssessedBy")

  payReviewAssessments     PayReviewAssessment[] @relation("PayReviewAssessmentEmployee")
  payReviewAssessmentsMade PayReviewAssessment[] @relation("PayReviewAssessmentReviewedBy")

  milestoneReviews       MilestoneReview[] @relation("MilestoneReviewEmployee")
  milestoneReviewsMade   MilestoneReview[] @relation("MilestoneReviewReviewedBy")

  pafsAsEmployee PersonnelActionForm[] @relation("PafEmployee")
  pafsCreated    PersonnelActionForm[] @relation("PafCreatedBy")
  pafsApproved   PersonnelActionForm[] @relation("PafApprovedBy")

  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreatedBy")
  messageTemplatesCreated  MessageTemplate[]  @relation("MessageTemplateCreatedBy")
  onboardingChecklistCompletions OnboardingChecklistItem[] @relation("OnboardingChecklistCompletedBy")
  signedDocuments          SignedDocument[]   @relation("SignedDocumentEmployee")
  signedDocumentsCreated   SignedDocument[]   @relation("SignedDocumentCreatedBy")

  complianceDocuments        ComplianceDocument[] @relation("ComplianceDocumentEmployee")
  complianceDocumentsCreated ComplianceDocument[] @relation("ComplianceDocumentCreatedBy")

  interviewAvailabilitySlotsCreated InterviewAvailabilitySlot[]

  @@index([role])
}

// Grants a user access to a department beyond their home HR area — e.g. an
// assistant who should see (and maybe edit) Sales but nothing else. Admin/
// Owner bypasses this entirely and always sees every department with full
// edit rights; everyone else always has implicit view access to HR.
model DepartmentAccess {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department
  canEdit    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, department])
}

model Module {
  id            String   @id @default(cuid())
  slug          String   @unique
  order         Int
  titleEn       String
  titleEs       String?
  summaryEn     String?
  summaryEs     String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons       Lesson[]
  quizQuestions QuizQuestion[]
  progress      ModuleProgress[]
  quizAttempts  QuizAttempt[]

  @@index([order])
}

model Lesson {
  id         String   @id @default(cuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order      Int
  titleEn    String
  titleEs    String?
  contentEn  String   @db.Text
  contentEs  String?  @db.Text
  videoUrl   String?
  // A separately-generated Spanish-dubbed version of the same video (e.g. via
  // Synthesia's translate/dub feature). Shown instead of videoUrl to trainees
  // whose language is Spanish, when present.
  videoUrlEs String?
  // A written transcript of what's spoken in the video, shown as text below
  // it — this app embeds videos from external platforms (Synthesia, YouTube,
  // Loom, Vimeo), so we can't add a synced subtitle track to them ourselves.
  videoTranscriptEn String? @db.Text
  videoTranscriptEs String? @db.Text
  // How long the trainee must keep this lesson open before "Continue"
  // unlocks — set by an admin to roughly the video's runtime. Null means
  // no minimum wait (text-only lessons, or a video without a known length).
  videoDurationSeconds Int?
  // A compressed base64 data URI (or external URL) for an optional photo/
  // diagram shown above the lesson text. @db.Text since a data URI is
  // far longer than the default varchar limit.
  imageUrl   String? @db.Text
  estimatedMinutes Int?
  // Lets an admin hide a single lesson from trainees (e.g. still being
  // written, or pulled from the curriculum) without deleting it or
  // unpublishing the whole module. Defaults to true so existing/new
  // lessons stay visible unless explicitly hidden.
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress LessonProgress[]

  @@index([moduleId, order])
}

// One row per trainee per completed lesson — lets the step-by-step lesson
// flow know where to resume and stops a trainee from skipping ahead via URL.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id         String       @id @default(cuid())
  moduleId   String
  module     Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  textEs     String?
  options    QuizOption[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([moduleId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  textEs     String?
  isCorrect  Boolean      @default(false)

  @@index([questionId, order])
}

model ModuleProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, moduleId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scorePct  Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

// In-field day evaluations: a Trainer/Field Supervisor or Admin grades a
// trainee's actual on-site performance across a fixed set of skill
// categories, separate from the e-learning quizzes. Used to spot which
// specific skills need extra attention/training time.
model FieldEvaluation {
  id           String   @id @default(cuid())
  traineeId    String
  trainee      User     @relation("TraineeFieldEvaluations", fields: [traineeId], references: [id], onDelete: Cascade)
  gradedById   String
  gradedBy     User     @relation("GradedFieldEvaluations", fields: [gradedById], references: [id])
  fieldDate    DateTime
  generalNotes String?  @db.Text
  createdAt    DateTime @default(now())

  categories FieldEvalCategoryScore[]

  @@index([traineeId])
}

model FieldEvalCategoryScore {
  id           String          @id @default(cuid())
  evaluationId String
  evaluation   FieldEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categoryKey  String
  score        Int
  checkedItems Json
  notes        String?         @db.Text

  @@index([evaluationId])
}

// A single open position, e.g. a specific Indeed/ZipRecruiter ad. The
// public application form lives at /apply/[slug].
model JobPosting {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String
  // Optional Spanish translation of the title — falls back to titleEn
  // wherever a bilingual applicant-facing message needs the position name
  // (e.g. the in-person interview confirmation email) and this isn't set.
  titleEs      String?
  positionType String?
  descriptionEn String  @db.Text
  // Recruiting 2.0: whether the mobile application form requires a resume
  // before it can be submitted. Off by default (a Cleaning Technician
  // applicant frequently has no polished resume) — future office/admin
  // postings can turn this on per posting without a code change.
  resumeRequired Boolean @default(false)
  // Percentage of the max possible prescreen score an applicant needs to
  // auto-pass and move on to scheduling a phone/Zoom interview.
  passThresholdPct Int  @default(70)
  // Which hiring-toolkit track this posting follows — drives the interview
  // scorecard's competency list and which role-differentiated phone-screen
  // / interview questions apply. See JobPostingRoleTrack.
  roleTrack    JobPostingRoleTrack @default(OTHER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prescreenQuestions  PrescreenQuestion[]
  phoneScreenQuestions PhoneScreenQuestion[]
  interviewQuestions  InterviewQuestion[]
  applicants          Applicant[]
  availabilitySlots   InterviewAvailabilitySlot[]
}

// REQUIRED questions gate prescreen pass/fail (their option points count
// toward passThresholdPct, exactly as every prescreen question already
// did before Recruiting 2.0 — default preserves that behavior for every
// existing question). PREFERRED questions are informational only —
// scorePrescreenAnswers excludes them from the score/maxScore entirely, so
// they can never disqualify anyone, but the applicant's answer is still
// saved and shown as a transparent "meets preferred qualification" signal
// on the Quick Review card.
// QUALIFICATION/APPLICATION/CULTURE_BEHAVIORAL/OPTIONAL (added for the full
// Cleaning Technician application) are the same two behaviors under new
// names: QUALIFICATION scores exactly like REQUIRED; APPLICATION,
// CULTURE_BEHAVIORAL, and OPTIONAL are all informational-only exactly like
// PREFERRED. Kept as separate enum values (rather than reusing
// REQUIRED/PREFERRED) purely so a question's category in the admin UI and
// on the Quick Review card reads as what it actually is — a hard
// requirement, general application info, a behavioral/culture question, or
// a nice-to-know — without relabeling anything that already shipped.
enum PrescreenQuestionCategory {
  REQUIRED
  PREFERRED
  QUALIFICATION
  APPLICATION
  CULTURE_BEHAVIORAL
  OPTIONAL
}

// SINGLE_SELECT (default) is the original — and only — shape every
// pre-Recruiting-2.0 question used, so every existing question keeps
// working unchanged. MULTI_SELECT lets an applicant check more than one
// option (stored as one PrescreenAnswer row per checked option). TEXT is a
// free-written response (stored in PrescreenAnswer.answerText, no option).
// DATE is a single date value, also stored in answerText as an ISO date
// string — not worth a whole separate column for one field.
enum PrescreenQuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  DATE
}

model PrescreenQuestion {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  order        Int
  textEn       String
  // A short 1-3 word label for tight spaces (the Quick Review requirement
  // checklist, e.g. "M-F Availability" instead of the full question
  // sentence). Falls back to textEn wherever unset, so every existing
  // question keeps rendering exactly as before.
  shortLabel   String?
  category     PrescreenQuestionCategory @default(REQUIRED)
  type         PrescreenQuestionType     @default(SINGLE_SELECT)
  // Whether the applicant must answer this before submitting. Defaults to
  // true since every pre-Recruiting-2.0 question was implicitly required.
  required     Boolean    @default(true)
  // Recommended character count shown to the applicant as they type a
  // TEXT answer — purely a UI hint, never enforced as a hard cutoff.
  maxLength    Int?
  // Free-text grouping label for the multi-step application wizard (e.g.
  // "Cleaning Experience", "Let's Get to Know You") — display-only, never
  // used for scoring, so it can be renamed later without touching logic.
  stepLabel    String?
  // Set when this question should only be shown/counted if the applicant
  // selected a specific option on another question (e.g. an "Other, please
  // explain" follow-up, or "how many years cleaned independently" only
  // after choosing "I primarily cleaned independently"). A conditional
  // QUALIFICATION question is excluded from both score and maxScore for
  // any applicant who never triggered it — see scorePrescreenAnswers.
  conditionalOnOptionId String?
  conditionalOnOption   PrescreenOption? @relation("ConditionalTrigger", fields: [conditionalOnOptionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  options PrescreenOption[] @relation("QuestionOptions")
  answers PrescreenAnswer[]

  @@index([jobPostingId, order])
  @@index([conditionalOnOptionId])
}

model PrescreenOption {
  id         String            @id @default(cuid())
  questionId String
  question   PrescreenQuestion @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  // Point value toward the applicant's auto-calculated compatibility score.
  points     Int               @default(0)

  answers PrescreenAnswer[]
  triggeredQuestions PrescreenQuestion[] @relation("ConditionalTrigger")

  @@index([questionId, order])
}

// An applicant who applied to a JobPosting. Resume is stored the same way
// lesson photos are (a base64 data URI directly on the row) since the app
// has no separate file/blob storage.
model Applicant {
  id             String          @id @default(cuid())
  jobPostingId   String
  jobPosting     JobPosting      @relation(fields: [jobPostingId], references: [id])
  firstName      String
  lastName       String
  email          String
  phone          String
  resumeDataUrl  String?         @db.Text
  resumeFileName String?
  stage          ApplicantStage  @default(NEW)
  // Where this applicant came from — CAREERS_PAGE by default for the public
  // /apply/[slug] form, overridden by a ?src= query param on job-board
  // postings that link there (see parseApplicantSource), or picked
  // explicitly on the manual "add applicant" form.
  source         ApplicantSource @default(OTHER)
  // Recruiting 2.0: the city they typed on the application — shown on the
  // Quick Review card ("where are they?") only. The "lives near the office"
  // preferred qualifier is a self-attested Yes/No prescreen question instead
  // of a city match against this field, since there's no verified office
  // address or real distance data to match against.
  city           String?
  // Full click-through attribution, captured from the application URL's
  // query string alongside (not replacing) the existing ?src= handling.
  // Nullable since most existing/organic applicants never had these.
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  prescreenScore    Int?
  prescreenMaxScore Int?
  prescreenPassed   Boolean?
  notes          String?        @db.Text
  scheduledAt    DateTime?
  // Set whenever scheduledAt is (re)set for an interview stage — the token
  // in the "Yes, I'll be there" link sent with the reminders, and the
  // record of whether/when they clicked it. Cleared and regenerated on a
  // reschedule so a stale confirmation never carries over to a new time.
  interviewConfirmToken       String?   @unique
  interviewConfirmedAt        DateTime?
  // Set when the applicant clicks "I can't make it" on the confirm page —
  // deliberately does NOT let them pick a new time themselves; it just
  // flags this for a staffer to see and reach out. Stops further reminders
  // for this interview once set (see interviewReminderScheduler).
  interviewCantMakeItAt       DateTime?
  interviewReminderDaySentAt  DateTime?
  interviewReminderHourSentAt DateTime?
  rejectedAt     DateTime?
  benchedAt      DateTime?
  hiredAt        DateTime?
  hiredUserId    String?        @unique
  hiredUser      User?          @relation("ApplicantHiredUser", fields: [hiredUserId], references: [id])
  // Stamped once, the first time a recruiter opens this applicant's profile
  // — a persistent "I've already looked into this person" marker, distinct
  // from moving them through the pipeline.
  viewedAt       DateTime?
  viewedById     String?
  viewedBy       User?          @relation("ApplicantViewedBy", fields: [viewedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  answers PrescreenAnswer[]
  communications CommunicationLog[]
  notesLog             ApplicantNote[]
  phoneScreenAnswers   PhoneScreenAnswer[]
  phoneScreenResult    PhoneScreenResult?
  interviewAnswers     InterviewQuestionAnswer[]
  interviewScorecards  InterviewScorecard[]
  workingSession       WorkingSessionRecord?
  referenceChecks      ReferenceCheck[]
  onboardingChecklist  OnboardingChecklistItem[]
  bookedSlot           InterviewAvailabilitySlot?

  @@index([jobPostingId, stage])
}

// One row per checklist item per applicant, only meaningful once they've
// reached HIRED. A fixed set of items (ONBOARDING_CHECKLIST_ITEMS in
// lib/recruiting.ts) is checked off either automatically — from data
// already tracked elsewhere (reference checks, signed onboarding docs, a
// hire date, a Pair assignment) — or manually by whoever is walking the new
// hire through onboarding. completedById is null for an auto-detected item,
// set to whoever ticked it by hand otherwise.
model OnboardingChecklistItem {
  id            String    @id @default(cuid())
  applicantId   String
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  itemKey       String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("OnboardingChecklistCompletedBy", fields: [completedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([applicantId, itemKey])
}

// Timestamped, authored internal-notes log — mirrors LeadNote so recruiting
// notes behave the same way the email/text communication thread does
// (append-only, who-said-it-and-when), instead of the old single
// Applicant.notes text field that silently overwrote itself on every edit.
model ApplicantNote {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([applicantId, createdAt])
}

// One row per selected option (SINGLE_SELECT: exactly one row; MULTI_SELECT:
// one row per checked option) or, for TEXT/DATE questions, one row with
// optionId null and the value in answerText. Answers are only ever written
// once, at application submission, so there's no update path that could
// race and create duplicates — the old @@unique([applicantId, questionId])
// is gone since MULTI_SELECT needs more than one row per question, but the
// application-create flow itself still only ever creates the right set.
model PrescreenAnswer {
  id          String            @id @default(cuid())
  applicantId String
  applicant   Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  questionId  String
  question    PrescreenQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String?
  option      PrescreenOption?  @relation(fields: [optionId], references: [id])
  answerText  String?           @db.Text

  @@index([applicantId, questionId])
}

enum CommChannel {
  EMAIL
  SMS
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

enum CommStatus {
  SENT
  FAILED
}

enum MessageTemplateScope {
  SALES
  RECRUITING
}

// A canned email/text a team member can pick from instead of writing the
// same outreach from scratch every time — e.g. "Thanks for Your Inquiry" or
// "Reminder: Upcoming Interview". Body/subject support {{firstName}} and
// (RECRUITING scope) {{position}} tokens, filled in client-side when picked.
model MessageTemplate {
  id          String               @id @default(cuid())
  scope       MessageTemplateScope
  channel     CommChannel
  name        String
  subject     String?
  body        String               @db.Text
  createdById String?
  createdBy   User?                @relation("MessageTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([scope, channel])
}

// Every email/text tied to an applicant, regardless of which manager sent
// it — shown together on the applicant's profile so nobody has to ask
// "did anyone already reach out to this person."
model CommunicationLog {
  id           String        @id @default(cuid())
  applicantId  String
  applicant    Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  channel      CommChannel
  direction    CommDirection @default(OUTBOUND)
  subject      String?
  body         String        @db.Text
  status       CommStatus    @default(SENT)
  errorMessage String?       @db.Text
  sentById     String?
  sentBy       User?         @relation(fields: [sentById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([applicantId, createdAt])
}

// Which structured hiring track a posting follows — drives which interview
// scorecard competency set applies (see INTERVIEW_SCORECARD_COMPETENCIES)
// and which role-differentiated phone-screen/interview questions show.
// OTHER covers Track B (forming a brand-new pair) — per the hiring toolkit,
// when the role isn't decided yet, both Lead- and Assistant-differentiated
// questions are asked so the answers can help with role assignment.
enum JobPostingRoleTrack {
  LEAD_TECHNICIAN
  ASSISTANT_TECHNICIAN
  OTHER
}

// A fixed, competency-mapped phone-screen question bank per job posting —
// every candidate for the same posting is asked the same questions, in the
// same order (the hiring toolkit's core consistency principle). Seeded with
// the standard 15-minute bilingual script when a posting is created;
// editable per posting afterward.
model PhoneScreenQuestion {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  order        Int
  textEn       String     @db.Text
  textEs       String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  answers PhoneScreenAnswer[]

  @@index([jobPostingId, order])
}

// What the applicant actually said to each phone-screen question, logged by
// whoever conducted the call — free text, not scored (the phone screen is
// pass/fail against hard requirements, not a ranking stage).
model PhoneScreenAnswer {
  id           String              @id @default(cuid())
  applicantId  String
  applicant    Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  questionId   String
  question     PhoneScreenQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseText String?             @db.Text
  updatedAt    DateTime            @updatedAt

  @@unique([applicantId, questionId])
}

enum PhoneScreenOutcome {
  PROCEED
  HOLD
  DECLINE
}

// The pass/fail hard-requirement checklist + outcome from the Phone Screen
// Form — one per applicant. criteriaChecklist holds the requirement rows
// as [{label, checked}] (mirrors the Working Session pre-day checklist, and
// the Lead lead-form's customFields Json pattern) so the exact wording can
// be adjusted without a migration.
model PhoneScreenResult {
  id             String              @id @default(cuid())
  applicantId    String              @unique
  applicant      Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  criteriaChecklist Json?
  languageNote   String?
  outcome        PhoneScreenOutcome?
  redFlagsNotes  String?             @db.Text
  completedById  String?
  completedBy    User?               @relation(fields: [completedById], references: [id])
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum InterviewQuestionRole {
  ALL
  LEAD_ONLY
  ASSISTANT_ONLY
}

// The 45-minute structured in-person interview's fixed question bank — 6
// core competency questions asked of every candidate, plus role-
// differentiated questions shown only for the relevant track (or both, for
// an undecided Track B posting). whatToListenFor surfaces the doc's
// scoring guidance right next to the question while the interviewer is
// taking notes.
model InterviewQuestion {
  id              String                @id @default(cuid())
  jobPostingId    String
  jobPosting      JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  order           Int
  competency      String
  textEn          String                @db.Text
  textEs          String?               @db.Text
  whatToListenFor String?               @db.Text
  roleScope       InterviewQuestionRole @default(ALL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  answers InterviewQuestionAnswer[]

  @@index([jobPostingId, order])
}

model InterviewQuestionAnswer {
  id           String            @id @default(cuid())
  applicantId  String
  applicant    Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  questionId   String
  question     InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseText String?           @db.Text
  updatedAt    DateTime          @updatedAt

  @@unique([applicantId, questionId])
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

// Recruiting 2.0 — a specific interview time Shar has explicitly made
// available. This is NOT a calendar/availability engine: there is no
// recurrence, no external calendar sync, and no auto-generation. An admin
// types in exact slots by hand; a candidate invited to interview can only
// pick from open (bookedById: null) ones. jobPostingId is optional so the
// default admin experience is "general availability" not tied to a single
// posting — only set it when MCC is running multiple concurrent hiring
// pushes and needs to keep their slots separate.
model InterviewAvailabilitySlot {
  id              String     @id @default(cuid())
  jobPostingId    String?
  jobPosting      JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  durationMins    Int        @default(30)
  // Set the moment a candidate claims this slot — the update that sets
  // this is conditioned on it still being null (see bookInterviewSlot in
  // lib/recruiting.ts), which is what actually prevents double-booking;
  // this column being non-null is just the resulting state.
  bookedById      String?    @unique
  bookedApplicant Applicant? @relation(fields: [bookedById], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User       @relation(fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())

  @@unique([startsAt, jobPostingId])
  @@index([jobPostingId, startsAt])
}

// The competency scorecard completed after the interview (Structured
// Interview Scorecard — Lead/Assistant forms). Multiple scorecards per
// applicant are allowed on purpose — the toolkit expects each panelist to
// score independently before a calibration discussion, rather than
// averaging scores from a single shared form.
model InterviewScorecard {
  id             String                   @id @default(cuid())
  applicantId    String
  applicant      Applicant                @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  evaluatorId    String?
  evaluator      User?                    @relation(fields: [evaluatorId], references: [id])
  recommendation InterviewRecommendation?
  rationale      String?                  @db.Text
  concerns       String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  competencyScores InterviewCompetencyScore[]

  @@index([applicantId, createdAt])
}

// One row per scored competency on a scorecard (Integrity & Trust, Pair
// Leadership, etc. — see INTERVIEW_SCORECARD_COMPETENCIES for the exact
// Lead vs. Assistant lists). A child table rather than fixed columns since
// the competency set differs by role track.
model InterviewCompetencyScore {
  id          String              @id @default(cuid())
  scorecardId String
  scorecard   InterviewScorecard  @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competency  String
  score       Int?
  evidence    String?             @db.Text

  @@index([scorecardId])
}

// The paid 3-4 hour working-session (Forms 5 + 6 combined into one record):
// pre-day checklist, the Lead's end-of-session observation scores, and
// their written assessment + hire recommendation. One per applicant — the
// working session is completed once, by the Lead who ran it.
model WorkingSessionRecord {
  id                    String                    @id @default(cuid())
  applicantId           String                    @unique
  applicant             Applicant                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime?
  housesToVisit         String?
  // [{label, checked}] — the Form 5 pre-day checklist items.
  preSessionChecklist   Json?
  leadEvaluatorId       String?
  leadEvaluator         User?                     @relation(fields: [leadEvaluatorId], references: [id])
  technicalScore        Int?
  technicalNotes        String?                   @db.Text
  paceStaminaScore      Int?
  paceStaminaNotes      String?                   @db.Text
  attentionDetailScore  Int?
  attentionDetailNotes  String?                   @db.Text
  clientHomeScore       Int?
  clientHomeNotes       String?                   @db.Text
  coachabilityScore     Int?
  coachabilityNotes     String?                   @db.Text
  pairDynamicScore      Int?
  pairDynamicNotes      String?                   @db.Text
  safetyScore           Int?
  safetyNotes           String?                   @db.Text
  honestAssessment      String?                   @db.Text
  concernsRaised         String?                  @db.Text
  recommendation        InterviewRecommendation?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

enum ReferenceVerdict {
  STRONG_POSITIVE
  GENERALLY_POSITIVE
  MIXED
  NEGATIVE
}

// One reference call (Reference Check Form, bilingual) — an applicant gets
// multiple rows here since the toolkit requires at least 2 reference calls
// per finalist.
model ReferenceCheck {
  id                     String            @id @default(cuid())
  applicantId            String
  applicant              Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  referenceName          String?
  referenceRelationship  String?
  durationKnown          String?
  referencePhone         String?
  calledAt               DateTime?
  capacityDuration       String?           @db.Text
  responsibilities       String?           @db.Text
  strengths              String?           @db.Text
  growthAreas            String?           @db.Text
  customerFacing         String?           @db.Text
  handledFeedback        String?           @db.Text
  wouldRehire            String?           @db.Text
  anythingElse           String?           @db.Text
  verdict                ReferenceVerdict?
  redFlagsSurfaced       String?           @db.Text
  completedById          String?
  completedBy            User?             @relation(fields: [completedById], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([applicantId])
}

// Generic shared key-value store for the Sales pricing/quotes tool — it was
// built with its own storage abstraction (get/set/delete/list by key, with
// a key prefix for listing) already designed for a shared backend; this
// gives it one instead of browser localStorage, so quotes, cost settings,
// and profitability data are the same for everyone with Sales access
// regardless of device or browser.
model SalesToolData {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// A policy/paperwork document new employees must read and sign before they
// can start training. Content can be typed directly (contentText) and/or an
// uploaded PDF (fileDataUrl, stored as a base64 data URI — same convention
// as Lesson.imageUrl / Applicant.resumeDataUrl, since the app has no
// separate file storage). assignByDefault means every newly invited
// employee automatically gets this one assigned; existing employees are
// assigned/unassigned individually via OnboardingAssignment.
model OnboardingDocument {
  id              String   @id @default(cuid())
  title           String
  contentText     String?  @db.Text
  fileDataUrl     String?  @db.Text
  fileName        String?
  assignByDefault Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments OnboardingAssignment[]
}

// One document assigned to one employee. signedAt/signedName are null until
// they sign — the pair together is the e-signature record (typed full name
// + timestamp), which is what gates that employee out of Training.
model OnboardingAssignment {
  id         String   @id @default(cuid())
  documentId String
  document   OnboardingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedAt   DateTime?
  signedName String?
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

enum DocumentFieldType {
  TEXT
  DATE
  NUMBER
  CHECKBOX
}

// A reusable personnel document template (offer letter, raise letter, W-4
// acknowledgment, etc.) — distinct from OnboardingDocument, which is a fixed
// policy acknowledgment assigned to every trainee. A template's bodyText
// holds {{key}} placeholders that get filled in per-employee when a
// SignedDocument is generated from it.
model DocumentTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  bodyText    String   @db.Text
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields          DocumentTemplateField[]
  signedDocuments SignedDocument[]
}

model DocumentTemplateField {
  id         String            @id @default(cuid())
  templateId String
  template   DocumentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  fieldType  DocumentFieldType @default(TEXT)
  required   Boolean           @default(true)
  order      Int               @default(0)

  @@unique([templateId, key])
}

// One filled-out copy of a template for one employee. fieldValues holds the
// admin-entered answers keyed by DocumentTemplateField.key. signedAt/
// signedName are null until the employee themself signs it (same typed-
// name-+-timestamp e-signature idiom as OnboardingAssignment) — signing is
// what stamps pdfDataUrl, so the PDF always reflects the final signed text.
model SignedDocument {
  id          String           @id @default(cuid())
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    User             @relation("SignedDocumentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  fieldValues Json
  signedAt    DateTime?
  signedName  String?
  pdfDataUrl  String?          @db.Text
  createdById String
  createdBy   User             @relation("SignedDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([employeeId])
}

enum ComplianceDocType {
  DRIVERS_LICENSE
  AUTO_INSURANCE
  TB_TEST
  BACKGROUND_CHECK
  OTHER
}

// A compliance-tracked document with a real expiration date (driver's
// license, auto insurance, TB test, background check) — distinct from
// SignedDocument/OnboardingDocument, neither of which expire. `label` is
// only used when docType is OTHER, to name whatever it is.
model ComplianceDocument {
  id             String            @id @default(cuid())
  employeeId     String
  employee       User              @relation("ComplianceDocumentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  docType        ComplianceDocType
  label          String?
  expirationDate DateTime
  fileDataUrl    String?           @db.Text
  fileName       String?
  notes          String?           @db.Text
  createdById    String
  createdBy      User              @relation("ComplianceDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId])
}

enum ComplaintStatus {
  OPEN
  VALID
  DISMISSED
}

// A client complaint logged against an employee's work or conduct. Starts
// OPEN when first logged; HR marks it VALID (counts toward the disciplinary
// thresholds described in training, e.g. 4 valid complaints in 60 days) or
// DISMISSED (doesn't count) once reviewed.
model Complaint {
  id              String          @id @default(cuid())
  employeeId      String
  employee        User            @relation("EmployeeComplaints", fields: [employeeId], references: [id], onDelete: Cascade)
  clientName      String
  incidentDate    DateTime?
  description     String          @db.Text
  status          ComplaintStatus @default(OPEN)
  loggedById      String
  loggedBy        User            @relation("ComplaintsLogged", fields: [loggedById], references: [id])
  resolutionNotes String?         @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
}

enum AttendanceEventKind {
  TARDY
  ABSENCE
  NO_CALL_NO_SHOW
  SENT_HOME
}

enum AttendanceReasonCategory {
  ILLNESS
  EMERGENCY
  FAMILY_EMERGENCY
  TRANSPORTATION
  OTHER
}

// A single attendance event logged against an employee (matches the
// categories in the Attendance & Workplace Policies training module). This
// app has no integration with TCS, the real time clock — HR/managers log
// these by hand as they happen.
model AttendanceEvent {
  id             String                    @id @default(cuid())
  employeeId     String
  employee       User                      @relation("EmployeeAttendanceEvents", fields: [employeeId], references: [id], onDelete: Cascade)
  kind           AttendanceEventKind
  reasonCategory AttendanceReasonCategory?
  eventDate      DateTime
  notes          String?                   @db.Text
  loggedById     String
  loggedBy       User                      @relation("AttendanceEventsLogged", fields: [loggedById], references: [id])
  createdAt      DateTime                  @default(now())

  @@index([employeeId])
}

// A biweekly (or whatever cadence HR runs) pay period that hours get
// entered against.
model PayPeriod {
  id               String                    @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  label            String
  createdAt        DateTime                  @default(now())
  entries          PayrollEntry[]
  unmatchedReports PayrollUnmatchedReport[]

  @@unique([startDate, endDate])
}

// A per-employee sheet from a payroll report workbook whose "Cleaner" name
// didn't match any employee on file (a middle name, nickname, or spelling
// difference) — held here so HR can manually attach it to the right
// employee instead of the whole sheet just being dropped on the floor.
// reportData is the parsed report (totals + job/adjustment line items,
// same shape importPayrollReport builds from the sheet) with all Date
// fields as ISO strings, since Prisma's Json type can't hold Date objects.
model PayrollUnmatchedReport {
  id          String    @id @default(cuid())
  payPeriodId String
  payPeriod   PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  rawName     String
  reportData  Json
  createdAt   DateTime  @default(now())

  @@unique([payPeriodId, rawName])
  @@index([payPeriodId])
}

enum PayrollEntryStatus {
  PENDING
  APPROVED
  DISPUTED
}

// One employee's hours for one pay period. Hours get in here either typed
// in directly, bulk-imported from a simple CSV export, or imported from the
// scheduling platform's per-employee payroll report workbook (one sheet per
// cleaner, with a per-job and per-adjustment breakdown — see PayrollJobLine
// and PayrollAdjustment). The totals* fields below are only populated for
// that richer import path and are trusted as given rather than re-derived
// from the job/adjustment rows, same reasoning as MonthlyFinancials.
// attachmentDataUrl is an optional reference document (e.g. a timesheet
// PDF) attached alongside — it's just shown to the employee, not parsed for
// its hours. The employee then reviews and either signs off (signedAt/
// signedName, same e-signature pattern as OnboardingAssignment) or disputes
// it with a note.
model PayrollEntry {
  id                 String             @id @default(cuid())
  payPeriodId        String
  payPeriod          PayPeriod          @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           User               @relation("EmployeePayrollEntries", fields: [employeeId], references: [id], onDelete: Cascade)
  regularHours       Float
  overtimeHours      Float              @default(0)
  // Report totals, only set when imported from a payroll report workbook.
  totalPayout        Float?
  jobsPayout         Float?
  adjustmentsPayout  Float?
  totalHours         Float?
  avgPayPerHour      Float?
  estimatedHours     Float?
  jobLines           PayrollJobLine[]
  adjustments        PayrollAdjustment[]
  attachmentDataUrl  String?            @db.Text
  attachmentFileName String?
  status             PayrollEntryStatus @default(PENDING)
  signedAt           DateTime?
  signedName         String?
  // A PDF snapshot of the entry as it looked at the moment of signing —
  // generated once, on sign, same pattern as SignedDocument.pdfDataUrl.
  // Cleared (along with signedAt/signedName) whenever the entry is reopened
  // for a fresh review, since it would otherwise show stale hours.
  signedPdfDataUrl   String?            @db.Text
  // Set when HR records the approval on the employee's behalf because they
  // signed a physical copy instead of using the app — signedAt/signedName
  // still hold the moment/name recorded, this just distinguishes it from
  // the employee's own e-signature so it reads correctly everywhere.
  signedViaOverride  Boolean            @default(false)
  overriddenById     String?
  overriddenBy       User?              @relation("PayrollOverriddenBy", fields: [overriddenById], references: [id], onDelete: SetNull)
  overrideNote       String?            @db.Text
  disputeNote        String?            @db.Text
  disputedAt         DateTime?
  resolutionNotes    String?            @db.Text
  resolvedAt         DateTime?
  // Last time a "please review & sign your hours" reminder email went out
  // for this entry, so the scheduler doesn't re-send on every tick — reset
  // to null wherever signedPdfDataUrl is (the entry being reopened means
  // the reminder clock should restart). Null forever once status leaves
  // PENDING.
  signatureReminderSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([payPeriodId, employeeId])
  @@index([employeeId])
}

// One completed job/cleaning visit that fed into a payroll report's payout
// for that pay period, imported verbatim from the scheduling platform's
// per-job table (Job ID, Customer, Service Type, ...).
model PayrollJobLine {
  id               String       @id @default(cuid())
  payrollEntryId   String
  payrollEntry     PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  jobExternalId    String
  customer         String
  serviceType      String
  performedDate    DateTime?
  clockIn          String
  clockOut         String
  actualTimeHours  Float
  serviceTimeHours Float
  payout           Float
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())

  @@index([payrollEntryId])
}

// One bonus/mileage/tip/travel-time/break-time adjustment that fed into a
// payroll report's payout, imported verbatim from the scheduling platform's
// per-adjustment table.
model PayrollAdjustment {
  id             String       @id @default(cuid())
  payrollEntryId String
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  sourceId       String
  amount         Float
  hours          Float
  type           String
  description    String       @db.Text
  date           DateTime?
  clockIn        String?
  clockOut       String?
  createdAt      DateTime     @default(now())

  @@index([payrollEntryId])
}

// One calendar month's full P&L, as reconciled by the owner/CFO agent from
// bank statements, Gusto, Stripe, Square, and QuickBooks. This is the most
// sensitive data in the app — restricted to ADMIN only, in full detail.
// Deliberately NOT auto-computed from the raw line items: some of the
// owner's own totals (opex_total in particular) don't equal a simple sum of
// the line items shown here, meaning her source spreadsheet folds in at
// least one more cost factor than what's broken out into its own column —
// so every field here is entered directly rather than derived, to avoid
// silently disagreeing with her own numbers.
model MonthlyFinancials {
  month                  String   @id // "2026-01"
  monthLabel             String // "Jan"
  revenueTotal           Float
  revenueCommercial      Float
  revenueResidential     Float
  cleanerTipsMemo        Float? // memo-only — tips are the cleaner's, not company revenue
  technicianPayroll      Float
  mileageReimbursements  Float
  supplies               Float
  cogsTotal              Float
  grossProfit            Float
  grossMarginPct         Float
  adminPayroll           Float
  rent                   Float
  hiringRecruiting       Float
  fuel                   Float
  insurance              Float
  vehicle                Float
  marketing              Float
  fees                   Float
  misc                   Float?
  creditCard             Float
  loanPayoff             Float
  stripeCapitalInterest  Float
  equipmentFinancing     Float
  opexTotal              Float
  netProfit              Float
  netMarginPct           Float
  target21pct            Float
  varianceToTarget       Float
  ownerDraw              Float
  endingBankBalance      Float
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Simple key/value JSONB settings the owner tunes over time (draw policy,
// profitability target, open loans). ADMIN only, same as MonthlyFinancials.
model OwnerSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// One QuickBooks Online company connection (OAuth). Unlike the app-level
// integrations (Outlook, RingCentral) whose credentials are static env
// vars, QuickBooks tokens are per-connection and rotate on every refresh,
// so they have to live in the DB, not the environment. Only ever expect
// one row — a single company — but nothing enforces that beyond app logic.
// Access tokens last ~1 hour; refresh tokens ~100 days and are single-use
// (each refresh returns a new one that must overwrite the old).
model QuickBooksConnection {
  id                    String   @id @default(cuid())
  realmId               String   @unique
  accessToken           String   @db.Text
  refreshToken          String   @db.Text
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  connectedById         String
  connectedBy           User     @relation(fields: [connectedById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Key/value JSONB the whole management team can see — the revenue growth
// staircase, current stage, and marketing budget. Deliberately separate
// from OwnerSetting so the access split (ADMIN vs ADMIN+SERVICE_MANAGER)
// is enforced by which table a query even touches, not by a per-row check.
model TeamGoal {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ChecklistFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ONE_TIME
  MILESTONE
}

enum ChecklistOwner {
  OWNER
  TEAM
}

enum ChecklistVisibility {
  OWNER_ONLY
  TEAM
}

// Groups checklist tasks into to-do-list-style subsections. Independent of
// owner/visibility — a category is "what area of the business is this
// about", not "who can see it".
enum ChecklistCategory {
  MARKETING
  SALES
  HR
  MANAGEMENT
}

// A running to-do list mixing recurring operating cadences (daily/weekly/
// monthly checks) with one-off and milestone items. Recurring tasks don't
// get a scheduled job to reset them — updatedAt is checked against the
// current day/week/month at read time (see effectiveChecklistStatus in
// lib/financials.ts), so a Daily task always reads as "Not Started" again
// once it was last touched outside today, with no cron involved.
model ChecklistTask {
  id          String              @id @default(cuid())
  frequency   ChecklistFrequency
  task        String
  owner       ChecklistOwner
  status      ChecklistTaskStatus @default(NOT_STARTED)
  completedAt DateTime?
  targetDate  DateTime?
  notes       String?             @db.Text
  visibility  ChecklistVisibility @default(OWNER_ONLY)
  category    ChecklistCategory   @default(MANAGEMENT)
  // Opt-in exception to the general Weekly-tasks-have-no-due-date rule (see
  // getEffectiveTargetDate in lib/checklistDisplay.ts) — for the rare weekly
  // task, like the Monday Team Update reminder, whose whole point IS a
  // Friday deadline. Left false for every other Weekly task.
  dueFridayOfWeek Boolean         @default(false)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

// A logged sales lead — table only for now. The full lead-capture form
// (under Sales), conversion tracking, and the KPI rollup feeding this
// dashboard are a separate, larger build to be scoped on its own.
enum LeadSource {
  WEBSITE_FORM
  PHONE_CALL
  WALK_IN
  REFERRAL
  GOOGLE_ADS
  FACEBOOK_ADS
  NEXTDOOR
  INSTAGRAM
  // Organic/word-of-mouth awareness — distinct from FACEBOOK_ADS, which is
  // reserved for paid-campaign spend tracking.
  FACEBOOK
  // Repeat/existing client booking again or referring themselves for
  // another property — distinct from REFERRAL (someone else referred them).
  CURRENT_CLIENT
  // A physical marketing card/flyer left at a property by a technician.
  LEAVE_BEHIND_CARD
  OTHER
}

enum LeadStage {
  NEW_INQUIRY
  CONTACTED
  QUOTED
  WON
  LOST
}

// A prospective client who hasn't (yet) become a paying job — separate from
// Applicant (job candidates) even though the pipeline shape rhymes, and
// separate from the Sales pricing tool's quotes (SalesToolData "quote:<id>"
// JSON blobs, not a real relation — quoteKey is just that key, stored as a
// plain string so a lead can point at a quote without a real FK).
model Lead {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String?
  source           LeadSource @default(OTHER)
  sourceDetail     String?
  serviceInterest  String?
  squareFootage    Int?
  message          String?   @db.Text
  stage            LeadStage @default(NEW_INQUIRY)
  estimatedValue   Float?
  quoteKey         String?
  lostReason       String?
  followUpDueAt    DateTime?
  firstContactedAt DateTime?
  // Snapshot of any custom lead-form-field answers at submission time —
  // [{label, value}], keyed by label rather than a live FK so relabeling or
  // deleting a LeadFormField later never corrupts a past lead's answers.
  customFields Json?
  assignedToId String?
  assignedTo   User?    @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  communications LeadCommunication[]
  notes          LeadNote[]
  stageChanges   LeadStageChange[]

  @@index([stage])
  @@index([source])
  @@index([assignedToId])
}

// Append-only activity log for internal notes — replaces a single
// overwritable notes field so a timestamp and author survive every entry.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Who moved a lead between pipeline stages, and when — setLeadStageAction
// and markLeadLostAction each write one of these on every transition.
model LeadStageChange {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   LeadStage?
  toStage     LeadStage
  changedById String?
  changedBy   User?      @relation(fields: [changedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([leadId, createdAt])
}

enum LeadFormFieldType {
  TEXT
  TEXTAREA
  SELECT
}

// Owner-managed extra question on the public lead-capture form, beyond the
// fixed core fields (name/email/phone, which the rest of the app depends on
// for notifications, texting, and dedup) and the built-in optional fields
// (address/service interest/message, toggled via the "leadform:config"
// SalesToolData key instead of a migration). Answers are snapshotted onto
// Lead.customFields at submission time, not tied back by a live FK.
model LeadFormField {
  id          String            @id @default(cuid())
  label       String
  fieldType   LeadFormFieldType @default(TEXT)
  placeholder String?
  required    Boolean           @default(false)
  options     String?           @db.Text // newline-separated choices, SELECT only
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Parallel to CommunicationLog (applicants) — kept as its own model rather
// than making CommunicationLog.applicantId polymorphic, so the working,
// tested applicant communication feature can't be put at risk by this change.
model LeadCommunication {
  id           String        @id @default(cuid())
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      CommChannel
  direction    CommDirection @default(OUTBOUND)
  subject      String?
  body         String        @db.Text
  status       CommStatus    @default(SENT)
  errorMessage String?       @db.Text
  sentById     String?
  sentBy       User?         @relation(fields: [sentById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([leadId, createdAt])
}

// Manual monthly ad-spend entry per source, for the Source ROI KPI (cost per
// lead / cost per won job) — there's no ad-platform integration, so this is
// entered by hand the same way Sales' revenue goal and actuals already are.
model LeadSourceSpend {
  id          String     @id @default(cuid())
  source      LeadSource
  monthKey    String
  amountSpent Float
  updatedAt   DateTime   @updatedAt

  @@unique([source, monthKey])
}

enum LoanStatus {
  OPEN
  CLOSED
}

// A business loan/MCA/equipment-financing balance. currentBalance is
// entered/updated by the owner periodically (not reconstructed from a live
// payment ledger) — the expected payoff date is then estimated as
// currentBalance / minimumPayment periods, spaced by minimumPaymentFrequency
// (see estimateLoanPayoff in lib/loans.ts). For MCA-style loans repaid via a
// % holdback of daily sales, minimumPayment is only a contractual floor, so
// the real payoff is usually sooner than this estimate — never later.
model Loan {
  id                       String     @id @default(cuid())
  lender                   String
  loanType                 String? // e.g. "merchant_cash_advance", "equipment_installment"
  status                   LoanStatus @default(OPEN)
  originationDate          DateTime?
  closedDate               DateTime?
  loanAmount               Float?
  feeAmount                Float?
  totalToRepay             Float?
  repaymentRatePct         Float? // % of daily sales withheld — informational only
  minimumPayment           Float?
  minimumPaymentFrequency  String? // "monthly" | "every_60_days" | "weekly" | "daily"
  repaymentStartDate       DateTime?
  maturityDate             DateTime?
  priorLoanBalance         Float?
  netProceeds              Float?
  currentBalance           Float? // owner-entered, drives the payoff estimate
  currentBalanceAsOf       DateTime?
  notes                    String?    @db.Text
  order                    Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  repayments LoanRepayment[]
}

// Historical monthly repayment record, for reference — not used to derive
// currentBalance going forward (see the note on Loan above).
model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month           String // "2026-01"
  interestFeePaid Float?
  principalPaid   Float?
  totalPaid       Float
  createdAt       DateTime @default(now())

  @@unique([loanId, month])
}

enum WeeklyUpdateStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
}

// The weekly "Monday Team Update" posted to Slack. Filled out Thu/Fri for
// the coming Monday, reviewed/approved by anyone with Management edit
// access, then posted automatically at 8:05am Pacific the following Monday
// by the in-process scheduler (see instrumentation.ts) — regardless of
// exactly when during the week it was approved. formattedMessage is built
// once at save time (see formatWeeklyUpdate in lib/weeklyUpdate.ts) so the
// preview shown for approval is exactly what gets sent.
model WeeklyUpdate {
  id                   String             @id @default(cuid())
  weekOf               DateTime // the Monday this update is FOR
  spotlightName        String
  spotlightReason      String             @db.Text
  homesCleaned         Int
  commercialServiced   Int                @default(0)
  avgRating            Float
  clientShoutout       String?            @db.Text
  companyUpdates       String?            @db.Text
  weeklyGoal           String             @db.Text
  coreValue            String
  coreValueDescription String             @db.Text
  formattedMessage     String             @db.Text
  status               WeeklyUpdateStatus @default(DRAFT)
  createdById          String?
  createdBy            User?              @relation("WeeklyUpdateCreatedBy", fields: [createdById], references: [id])
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("WeeklyUpdateApprovedBy", fields: [approvedById], references: [id])
  sentAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([weekOf])
}

// ── HR Phase 1: Pair / Promotion / Milestone foundation ──
// A Field Team pairing: one Lead + one Assistant. Changing a pair logs a new
// row and closes out the old one (endDate + active:false) rather than
// overwriting it — HR needs pairing history, not just current state. At most
// one active pair per leadId and per assistantId is enforced with a partial
// unique index (see migration.sql), matching the "exactly one partner at a
// time" rule.
model Pair {
  id          String    @id @default(cuid())
  leadId      String
  lead        User      @relation("PairLead", fields: [leadId], references: [id], onDelete: Cascade)
  assistantId String
  assistant   User      @relation("PairAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("PairCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([assistantId])
}

// Who a Trainer is personally responsible for training — separate from
// Pair (which tracks day-to-day field partnerships, not mentorship).
// Unlike Pair, a Trainer can have several trainees actively assigned at
// once (no unique constraint on trainerId); a trainee has at most one
// active assigned trainer at a time (partial unique index on traineeId,
// see migration.sql). This is also the scoping boundary for what a
// Trainer can see in the portal — /trainer/employees and the Trainer home
// page only show trainees with an active assignment to that Trainer.
// Ending or reassigning is always manual (ADMIN/SERVICE_MANAGER), never
// automatic.
model TrainingAssignment {
  id          String    @id @default(cuid())
  trainerId   String
  trainer     User      @relation("TrainingAssignmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  traineeId   String
  trainee     User      @relation("TrainingAssignmentTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("TrainingAssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([trainerId])
  @@index([traineeId])
}

enum PromotionTargetRole {
  ASSISTANT
  LEAD
  TRAINER
}

enum PromotionDecision {
  PROMOTE
  DEVELOP
  STAY
  ADDRESS
}

// Structured, queryable promotion pathway data (Assistant -> Lead -> Trainer)
// replacing what used to live only in Word documents. readinessIndicators is
// a JSON array of {label, met} pairs — the specific indicator text is a
// judgment call that will likely get revised after the first few promotions,
// so it's kept as editable app-config content (see READINESS_INDICATORS_BY_ROLE
// in src/lib/promotions.ts), not baked into separate DB columns.
// payDifferential is ADMIN-only — SERVICE_MANAGER should never see or set it
// even though the rest of the record is visible to them; enforced in the
// server action and stripped by serializePromotionAssessmentForRole before
// ever reaching a SERVICE_MANAGER's page. A CHECK constraint (see
// migration.sql) enforces that a DEVELOP decision always carries a
// development plan and a reassessment date.
model PromotionAssessment {
  id                  String              @id @default(cuid())
  employeeId          String
  employee            User               @relation("PromotionAssessmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  targetRole          PromotionTargetRole
  readinessIndicators Json
  decision            PromotionDecision
  developmentPlan     String?             @db.Text
  reassessmentDate    DateTime?
  payDifferential     Float?
  assessedById        String
  assessedBy          User                @relation("PromotionAssessmentAssessedBy", fields: [assessedById], references: [id])
  assessedAt           DateTime           @default(now())
  createdAt           DateTime            @default(now())

  linkedPaf PersonnelActionForm?

  @@index([employeeId])
}

enum PayReviewDecision {
  APPROVED
  DENIED
  DEFERRED
}

// A structured raise/pay-review record, mirroring PromotionAssessment —
// the assessment is the evaluation, and an Approved decision auto-generates
// a linked draft PAY_CHANGE PAF that actually authorizes payroll to act.
// ADMIN-only end to end (creation, viewing, deletion): unlike Promotion,
// there's no partial view for a SERVICE_MANAGER since every field here is
// comp data.
model PayReviewAssessment {
  id             String            @id @default(cuid())
  employeeId     String
  employee       User              @relation("PayReviewAssessmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  currentPay     Float
  recommendedPay Float
  justification  String            @db.Text
  decision       PayReviewDecision
  effectiveDate  DateTime?
  reviewedById   String
  reviewedBy     User              @relation("PayReviewAssessmentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  linkedPaf PersonnelActionForm?

  @@index([employeeId])
}

enum MilestoneCheckpoint {
  DAY_30
  DAY_60
  DAY_90
}

// 30/60/90-day milestone reviews. Due date is never stored — it's always
// computed at read time from the employee's real User.startDate (see
// getMilestoneDueDate in src/lib/milestones.ts), since a manually-typed
// tenure field is exactly what caused confusion in MCC's old spreadsheet.
// A row only exists once a review has actually been started/completed;
// "not started yet" for a checkpoint that's already due is computed by
// the absence of a row, not a stored status.
model MilestoneReview {
  id           String              @id @default(cuid())
  employeeId   String
  employee     User                @relation("MilestoneReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  checkpoint   MilestoneCheckpoint
  completedAt  DateTime?
  score        Int?
  notes        String?             @db.Text
  reviewedById String?
  reviewedBy   User?               @relation("MilestoneReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([employeeId, checkpoint])
}

// ── Personnel Action Form (PAF) ──
// The execution record for pay changes, transfers, title changes, and
// terminations — distinct from PromotionAssessment (the evaluation: "did
// they earn it, what's the evidence") in that a PAF is "what changed,
// effective when, approved by whom." Deciding a PromotionAssessment
// "Promote" auto-generates a linked draft PAF; a PAF can also stand alone
// for actions that never went through an assessment. Creating/approving a
// PAF is ADMIN-only — the record that actually authorizes payroll to act.
enum PafActionType {
  PROMOTION
  PAY_CHANGE
  TRANSFER
  TITLE_CHANGE
  TERMINATION
  OTHER
}

enum PafStatus {
  DRAFT
  APPROVED
  EXECUTED
}

model PersonnelActionForm {
  id                 String               @id @default(cuid())
  employeeId         String
  employee           User                 @relation("PafEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  actionType         PafActionType
  effectiveDate      DateTime
  priorTitle         String?
  newTitle           String?
  priorPay           Float?
  newPay             Float?
  priorDepartment    String?
  newDepartment      String?
  reason             String?              @db.Text
  linkedAssessmentId String?              @unique
  linkedAssessment   PromotionAssessment? @relation(fields: [linkedAssessmentId], references: [id], onDelete: SetNull)
  linkedPayReviewId  String?              @unique
  linkedPayReview    PayReviewAssessment? @relation(fields: [linkedPayReviewId], references: [id], onDelete: SetNull)
  status             PafStatus            @default(DRAFT)
  createdById        String
  createdBy          User                 @relation("PafCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?                @relation("PafApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([employeeId])
}
