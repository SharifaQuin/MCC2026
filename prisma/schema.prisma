generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINEE
  ADMIN
  TRAINER
  SERVICE_MANAGER
}

// A "vertical" of the business. HR is where the training/onboarding portal
// (everything built so far) lives; the others are placeholders until those
// departments get real content built out.
enum Department {
  SALES
  HR
  OPERATIONS
  MANAGEMENT
}

enum Language {
  EN
  ES
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// The recruiting pipeline: Applied -> auto-scored prescreen -> phone/Zoom
// interview -> in-person interview -> offer (sent manually via Gusto) ->
// Hired. REJECTED and BENCH are manager-confirmed off-ramps from any stage.
enum ApplicantStage {
  NEW
  PRESCREEN_FAILED
  PRESCREEN_PASSED
  PHONE_INTERVIEW_SCHEDULED
  PHONE_INTERVIEW_PASSED
  PHONE_INTERVIEW_FAILED
  IN_PERSON_SCHEDULED
  IN_PERSON_PASSED
  IN_PERSON_FAILED
  OFFER_SENT
  HIRED
  REJECTED
  BENCH
}

enum ApplicantSource {
  CAREERS_PAGE
  INDEED
  ZIPRECRUITER
  REFERRAL
  WALK_IN
  OTHER
}

// Tracks an employee's path from Trainee to certified Technician: a Trainer
// recommends once the 3-day field training is done, then a Manager/Admin
// makes the final call.
enum CertificationStatus {
  NOT_RECOMMENDED
  PENDING
  CERTIFIED
  DECLINED
}

model User {
  id               String    @id @default(cuid())
  // Human-facing identifier ("MCC-0001"), distinct from the internal cuid
  // `id` — assigned once at account creation from a Postgres sequence
  // (see the employee_id_seq migration), never reused or renumbered.
  employeeId       String?   @unique
  email            String    @unique
  name             String
  role             Role      @default(TRAINEE)
  passwordHash     String?
  mustSetPassword  Boolean   @default(true)
  active           Boolean   @default(true)
  inviteToken      String?   @unique
  inviteExpiresAt  DateTime?
  language         Language  @default(EN)
  lastLoginAt      DateTime?
  // When this person actually started working, not when their account was
  // created — used for years-of-service and upcoming-anniversary tracking
  // on the Staff dashboard. Backfilled from createdAt for existing users;
  // editable afterward since that's rarely their true start date.
  hireDate         DateTime?
  failedLoginAttempts Int    @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Departed is a distinct, HR-recorded roster status — not the same as a
  // plain `active=false` deactivation (which just revokes login access for
  // any reason). Marking someone departed also sets active=false; a rehire
  // clears these fields and reactivates the account.
  lastDay               DateTime?
  departureReason       String?   @db.Text
  departureRecordedById String?
  departureRecordedBy   User?     @relation("DepartureRecordedBy", fields: [departureRecordedById], references: [id], onDelete: SetNull)
  departuresRecorded    User[]    @relation("DepartureRecordedBy")
  // Null = not yet determined (the usual case right when someone is marked
  // departed, before an exit interview has happened) — distinct from false
  // (determined not eligible), so the two states aren't conflated.
  rehireEligible           Boolean?
  exitInterviewCompletedAt DateTime?
  exitInterviewNotes       String?   @db.Text

  progress       ModuleProgress[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  invitedBy    String?

  fieldEvaluationsReceived FieldEvaluation[] @relation("TraineeFieldEvaluations")
  fieldEvaluationsGiven    FieldEvaluation[] @relation("GradedFieldEvaluations")

  certificationStatus CertificationStatus @default(NOT_RECOMMENDED)
  certNotes           String?             @db.Text

  certRecommendedAt        DateTime?
  certRecommendedById      String?
  certRecommendedBy        User?     @relation("CertRecommendedBy", fields: [certRecommendedById], references: [id])
  certRecommendationsMade  User[]    @relation("CertRecommendedBy")

  certDecidedAt      DateTime?
  certDecidedById    String?
  certDecidedBy      User?     @relation("CertDecidedBy", fields: [certDecidedById], references: [id])
  certDecisionsMade  User[]    @relation("CertDecidedBy")

  departmentAccess DepartmentAccess[]
  sentCommunications CommunicationLog[]
  hiredFromApplicant Applicant? @relation("ApplicantHiredUser")
  applicantsViewed Applicant[] @relation("ApplicantViewedBy")
  onboardingAssignments OnboardingAssignment[]

  complaintsReceived Complaint[]       @relation("EmployeeComplaints")
  complaintsLogged   Complaint[]       @relation("ComplaintsLogged")
  attendanceEvents       AttendanceEvent[] @relation("EmployeeAttendanceEvents")
  attendanceEventsLogged AttendanceEvent[] @relation("AttendanceEventsLogged")
  payrollEntries     PayrollEntry[]    @relation("EmployeePayrollEntries")

  weeklyUpdatesCreated  WeeklyUpdate[] @relation("WeeklyUpdateCreatedBy")
  weeklyUpdatesApproved WeeklyUpdate[] @relation("WeeklyUpdateApprovedBy")

  pairsAsLead      Pair[] @relation("PairLead")
  pairsAsAssistant Pair[] @relation("PairAssistant")
  pairsCreated     Pair[] @relation("PairCreatedBy")

  promotionAssessments       PromotionAssessment[] @relation("PromotionAssessmentEmployee")
  promotionAssessmentsMade   PromotionAssessment[] @relation("PromotionAssessmentAssessedBy")

  payReviewAssessments     PayReviewAssessment[] @relation("PayReviewAssessmentEmployee")
  payReviewAssessmentsMade PayReviewAssessment[] @relation("PayReviewAssessmentReviewedBy")

  milestoneReviews       MilestoneReview[] @relation("MilestoneReviewEmployee")
  milestoneReviewsMade   MilestoneReview[] @relation("MilestoneReviewReviewedBy")

  pafsAsEmployee PersonnelActionForm[] @relation("PafEmployee")
  pafsCreated    PersonnelActionForm[] @relation("PafCreatedBy")
  pafsApproved   PersonnelActionForm[] @relation("PafApprovedBy")

  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreatedBy")
  signedDocuments          SignedDocument[]   @relation("SignedDocumentEmployee")
  signedDocumentsCreated   SignedDocument[]   @relation("SignedDocumentCreatedBy")

  complianceDocuments        ComplianceDocument[] @relation("ComplianceDocumentEmployee")
  complianceDocumentsCreated ComplianceDocument[] @relation("ComplianceDocumentCreatedBy")

  @@index([role])
}

// Grants a user access to a department beyond their home HR area — e.g. an
// assistant who should see (and maybe edit) Sales but nothing else. Admin/
// Owner bypasses this entirely and always sees every department with full
// edit rights; everyone else always has implicit view access to HR.
model DepartmentAccess {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department
  canEdit    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, department])
}

model Module {
  id            String   @id @default(cuid())
  slug          String   @unique
  order         Int
  titleEn       String
  titleEs       String?
  summaryEn     String?
  summaryEs     String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons       Lesson[]
  quizQuestions QuizQuestion[]
  progress      ModuleProgress[]
  quizAttempts  QuizAttempt[]

  @@index([order])
}

model Lesson {
  id         String   @id @default(cuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order      Int
  titleEn    String
  titleEs    String?
  contentEn  String   @db.Text
  contentEs  String?  @db.Text
  videoUrl   String?
  // A separately-generated Spanish-dubbed version of the same video (e.g. via
  // Synthesia's translate/dub feature). Shown instead of videoUrl to trainees
  // whose language is Spanish, when present.
  videoUrlEs String?
  // A written transcript of what's spoken in the video, shown as text below
  // it — this app embeds videos from external platforms (Synthesia, YouTube,
  // Loom, Vimeo), so we can't add a synced subtitle track to them ourselves.
  videoTranscriptEn String? @db.Text
  videoTranscriptEs String? @db.Text
  // How long the trainee must keep this lesson open before "Continue"
  // unlocks — set by an admin to roughly the video's runtime. Null means
  // no minimum wait (text-only lessons, or a video without a known length).
  videoDurationSeconds Int?
  // A compressed base64 data URI (or external URL) for an optional photo/
  // diagram shown above the lesson text. @db.Text since a data URI is
  // far longer than the default varchar limit.
  imageUrl   String? @db.Text
  estimatedMinutes Int?
  // Lets an admin hide a single lesson from trainees (e.g. still being
  // written, or pulled from the curriculum) without deleting it or
  // unpublishing the whole module. Defaults to true so existing/new
  // lessons stay visible unless explicitly hidden.
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress LessonProgress[]

  @@index([moduleId, order])
}

// One row per trainee per completed lesson — lets the step-by-step lesson
// flow know where to resume and stops a trainee from skipping ahead via URL.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id         String       @id @default(cuid())
  moduleId   String
  module     Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  textEs     String?
  options    QuizOption[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([moduleId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  textEs     String?
  isCorrect  Boolean      @default(false)

  @@index([questionId, order])
}

model ModuleProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, moduleId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scorePct  Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

// In-field day evaluations: a Trainer/Field Supervisor or Admin grades a
// trainee's actual on-site performance across a fixed set of skill
// categories, separate from the e-learning quizzes. Used to spot which
// specific skills need extra attention/training time.
model FieldEvaluation {
  id           String   @id @default(cuid())
  traineeId    String
  trainee      User     @relation("TraineeFieldEvaluations", fields: [traineeId], references: [id], onDelete: Cascade)
  gradedById   String
  gradedBy     User     @relation("GradedFieldEvaluations", fields: [gradedById], references: [id])
  fieldDate    DateTime
  generalNotes String?  @db.Text
  createdAt    DateTime @default(now())

  categories FieldEvalCategoryScore[]

  @@index([traineeId])
}

model FieldEvalCategoryScore {
  id           String          @id @default(cuid())
  evaluationId String
  evaluation   FieldEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categoryKey  String
  score        Int
  checkedItems Json
  notes        String?         @db.Text

  @@index([evaluationId])
}

// A single open position, e.g. a specific Indeed/ZipRecruiter ad. The
// public application form lives at /apply/[slug].
model JobPosting {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String
  positionType String?
  descriptionEn String  @db.Text
  // Percentage of the max possible prescreen score an applicant needs to
  // auto-pass and move on to scheduling a phone/Zoom interview.
  passThresholdPct Int  @default(70)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prescreenQuestions PrescreenQuestion[]
  applicants         Applicant[]
}

model PrescreenQuestion {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  order        Int
  textEn       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  options PrescreenOption[]
  answers PrescreenAnswer[]

  @@index([jobPostingId, order])
}

model PrescreenOption {
  id         String            @id @default(cuid())
  questionId String
  question   PrescreenQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  textEn     String
  // Point value toward the applicant's auto-calculated compatibility score.
  points     Int               @default(0)

  answers PrescreenAnswer[]

  @@index([questionId, order])
}

// An applicant who applied to a JobPosting. Resume is stored the same way
// lesson photos are (a base64 data URI directly on the row) since the app
// has no separate file/blob storage.
model Applicant {
  id             String          @id @default(cuid())
  jobPostingId   String
  jobPosting     JobPosting      @relation(fields: [jobPostingId], references: [id])
  firstName      String
  lastName       String
  email          String
  phone          String
  resumeDataUrl  String?         @db.Text
  resumeFileName String?
  stage          ApplicantStage  @default(NEW)
  // Where this applicant came from — CAREERS_PAGE by default for the public
  // /apply/[slug] form, overridden by a ?src= query param on job-board
  // postings that link there (see parseApplicantSource), or picked
  // explicitly on the manual "add applicant" form.
  source         ApplicantSource @default(OTHER)
  prescreenScore    Int?
  prescreenMaxScore Int?
  prescreenPassed   Boolean?
  notes          String?        @db.Text
  scheduledAt    DateTime?
  rejectedAt     DateTime?
  benchedAt      DateTime?
  hiredAt        DateTime?
  hiredUserId    String?        @unique
  hiredUser      User?          @relation("ApplicantHiredUser", fields: [hiredUserId], references: [id])
  // Stamped once, the first time a recruiter opens this applicant's profile
  // — a persistent "I've already looked into this person" marker, distinct
  // from moving them through the pipeline.
  viewedAt       DateTime?
  viewedById     String?
  viewedBy       User?          @relation("ApplicantViewedBy", fields: [viewedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  answers PrescreenAnswer[]
  communications CommunicationLog[]

  @@index([jobPostingId, stage])
}

model PrescreenAnswer {
  id          String            @id @default(cuid())
  applicantId String
  applicant   Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  questionId  String
  question    PrescreenQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String
  option      PrescreenOption   @relation(fields: [optionId], references: [id])

  @@unique([applicantId, questionId])
}

enum CommChannel {
  EMAIL
  SMS
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

enum CommStatus {
  SENT
  FAILED
}

// Every email/text tied to an applicant, regardless of which manager sent
// it — shown together on the applicant's profile so nobody has to ask
// "did anyone already reach out to this person."
model CommunicationLog {
  id           String        @id @default(cuid())
  applicantId  String
  applicant    Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  channel      CommChannel
  direction    CommDirection @default(OUTBOUND)
  subject      String?
  body         String        @db.Text
  status       CommStatus    @default(SENT)
  errorMessage String?       @db.Text
  sentById     String?
  sentBy       User?         @relation(fields: [sentById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([applicantId, createdAt])
}

// Generic shared key-value store for the Sales pricing/quotes tool — it was
// built with its own storage abstraction (get/set/delete/list by key, with
// a key prefix for listing) already designed for a shared backend; this
// gives it one instead of browser localStorage, so quotes, cost settings,
// and profitability data are the same for everyone with Sales access
// regardless of device or browser.
model SalesToolData {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// A policy/paperwork document new employees must read and sign before they
// can start training. Content can be typed directly (contentText) and/or an
// uploaded PDF (fileDataUrl, stored as a base64 data URI — same convention
// as Lesson.imageUrl / Applicant.resumeDataUrl, since the app has no
// separate file storage). assignByDefault means every newly invited
// employee automatically gets this one assigned; existing employees are
// assigned/unassigned individually via OnboardingAssignment.
model OnboardingDocument {
  id              String   @id @default(cuid())
  title           String
  contentText     String?  @db.Text
  fileDataUrl     String?  @db.Text
  fileName        String?
  assignByDefault Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments OnboardingAssignment[]
}

// One document assigned to one employee. signedAt/signedName are null until
// they sign — the pair together is the e-signature record (typed full name
// + timestamp), which is what gates that employee out of Training.
model OnboardingAssignment {
  id         String   @id @default(cuid())
  documentId String
  document   OnboardingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedAt   DateTime?
  signedName String?
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

enum DocumentFieldType {
  TEXT
  DATE
  NUMBER
  CHECKBOX
}

// A reusable personnel document template (offer letter, raise letter, W-4
// acknowledgment, etc.) — distinct from OnboardingDocument, which is a fixed
// policy acknowledgment assigned to every trainee. A template's bodyText
// holds {{key}} placeholders that get filled in per-employee when a
// SignedDocument is generated from it.
model DocumentTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  bodyText    String   @db.Text
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields          DocumentTemplateField[]
  signedDocuments SignedDocument[]
}

model DocumentTemplateField {
  id         String            @id @default(cuid())
  templateId String
  template   DocumentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  fieldType  DocumentFieldType @default(TEXT)
  required   Boolean           @default(true)
  order      Int               @default(0)

  @@unique([templateId, key])
}

// One filled-out copy of a template for one employee. fieldValues holds the
// admin-entered answers keyed by DocumentTemplateField.key. signedAt/
// signedName are null until the employee themself signs it (same typed-
// name-+-timestamp e-signature idiom as OnboardingAssignment) — signing is
// what stamps pdfDataUrl, so the PDF always reflects the final signed text.
model SignedDocument {
  id          String           @id @default(cuid())
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    User             @relation("SignedDocumentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  fieldValues Json
  signedAt    DateTime?
  signedName  String?
  pdfDataUrl  String?          @db.Text
  createdById String
  createdBy   User             @relation("SignedDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([employeeId])
}

enum ComplianceDocType {
  DRIVERS_LICENSE
  AUTO_INSURANCE
  TB_TEST
  BACKGROUND_CHECK
  OTHER
}

// A compliance-tracked document with a real expiration date (driver's
// license, auto insurance, TB test, background check) — distinct from
// SignedDocument/OnboardingDocument, neither of which expire. `label` is
// only used when docType is OTHER, to name whatever it is.
model ComplianceDocument {
  id             String            @id @default(cuid())
  employeeId     String
  employee       User              @relation("ComplianceDocumentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  docType        ComplianceDocType
  label          String?
  expirationDate DateTime
  fileDataUrl    String?           @db.Text
  fileName       String?
  notes          String?           @db.Text
  createdById    String
  createdBy      User              @relation("ComplianceDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId])
}

enum ComplaintStatus {
  OPEN
  VALID
  DISMISSED
}

// A client complaint logged against an employee's work or conduct. Starts
// OPEN when first logged; HR marks it VALID (counts toward the disciplinary
// thresholds described in training, e.g. 4 valid complaints in 60 days) or
// DISMISSED (doesn't count) once reviewed.
model Complaint {
  id              String          @id @default(cuid())
  employeeId      String
  employee        User            @relation("EmployeeComplaints", fields: [employeeId], references: [id], onDelete: Cascade)
  clientName      String
  incidentDate    DateTime?
  description     String          @db.Text
  status          ComplaintStatus @default(OPEN)
  loggedById      String
  loggedBy        User            @relation("ComplaintsLogged", fields: [loggedById], references: [id])
  resolutionNotes String?         @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
}

enum AttendanceEventKind {
  TARDY
  ABSENCE
  NO_CALL_NO_SHOW
  SENT_HOME
}

enum AttendanceReasonCategory {
  ILLNESS
  EMERGENCY
  FAMILY_EMERGENCY
  TRANSPORTATION
  OTHER
}

// A single attendance event logged against an employee (matches the
// categories in the Attendance & Workplace Policies training module). This
// app has no integration with TCS, the real time clock — HR/managers log
// these by hand as they happen.
model AttendanceEvent {
  id             String                    @id @default(cuid())
  employeeId     String
  employee       User                      @relation("EmployeeAttendanceEvents", fields: [employeeId], references: [id], onDelete: Cascade)
  kind           AttendanceEventKind
  reasonCategory AttendanceReasonCategory?
  eventDate      DateTime
  notes          String?                   @db.Text
  loggedById     String
  loggedBy       User                      @relation("AttendanceEventsLogged", fields: [loggedById], references: [id])
  createdAt      DateTime                  @default(now())

  @@index([employeeId])
}

// A biweekly (or whatever cadence HR runs) pay period that hours get
// entered against.
model PayPeriod {
  id        String         @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  label     String
  createdAt DateTime       @default(now())
  entries   PayrollEntry[]

  @@unique([startDate, endDate])
}

enum PayrollEntryStatus {
  PENDING
  APPROVED
  DISPUTED
}

// One employee's hours for one pay period. Hours get in here either typed
// in directly or bulk-imported from a CSV export; attachmentDataUrl is an
// optional reference document (e.g. a timesheet PDF) attached alongside —
// it's just shown to the employee, not parsed for its hours. The employee
// then reviews and either signs off (signedAt/signedName, same e-signature
// pattern as OnboardingAssignment) or disputes it with a note.
model PayrollEntry {
  id                 String             @id @default(cuid())
  payPeriodId        String
  payPeriod          PayPeriod          @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           User               @relation("EmployeePayrollEntries", fields: [employeeId], references: [id], onDelete: Cascade)
  regularHours       Float
  overtimeHours      Float              @default(0)
  attachmentDataUrl  String?            @db.Text
  attachmentFileName String?
  status             PayrollEntryStatus @default(PENDING)
  signedAt           DateTime?
  signedName         String?
  disputeNote        String?            @db.Text
  disputedAt         DateTime?
  resolutionNotes    String?            @db.Text
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([payPeriodId, employeeId])
  @@index([employeeId])
}

// One calendar month's full P&L, as reconciled by the owner/CFO agent from
// bank statements, Gusto, Stripe, Square, and QuickBooks. This is the most
// sensitive data in the app — restricted to ADMIN only, in full detail.
// Deliberately NOT auto-computed from the raw line items: some of the
// owner's own totals (opex_total in particular) don't equal a simple sum of
// the line items shown here, meaning her source spreadsheet folds in at
// least one more cost factor than what's broken out into its own column —
// so every field here is entered directly rather than derived, to avoid
// silently disagreeing with her own numbers.
model MonthlyFinancials {
  month                  String   @id // "2026-01"
  monthLabel             String // "Jan"
  revenueTotal           Float
  revenueCommercial      Float
  revenueResidential     Float
  cleanerTipsMemo        Float? // memo-only — tips are the cleaner's, not company revenue
  technicianPayroll      Float
  mileageReimbursements  Float
  supplies               Float
  cogsTotal              Float
  grossProfit            Float
  grossMarginPct         Float
  adminPayroll           Float
  rent                   Float
  hiringRecruiting       Float
  fuel                   Float
  insurance              Float
  vehicle                Float
  marketing              Float
  fees                   Float
  misc                   Float?
  creditCard             Float
  loanPayoff             Float
  stripeCapitalInterest  Float
  equipmentFinancing     Float
  opexTotal              Float
  netProfit              Float
  netMarginPct           Float
  target21pct            Float
  varianceToTarget       Float
  ownerDraw              Float
  endingBankBalance      Float
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Simple key/value JSONB settings the owner tunes over time (draw policy,
// profitability target, open loans). ADMIN only, same as MonthlyFinancials.
model OwnerSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Key/value JSONB the whole management team can see — the revenue growth
// staircase, current stage, and marketing budget. Deliberately separate
// from OwnerSetting so the access split (ADMIN vs ADMIN+SERVICE_MANAGER)
// is enforced by which table a query even touches, not by a per-row check.
model TeamGoal {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ChecklistFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ONE_TIME
  MILESTONE
}

enum ChecklistOwner {
  OWNER
  TEAM
}

enum ChecklistVisibility {
  OWNER_ONLY
  TEAM
}

// Groups checklist tasks into to-do-list-style subsections. Independent of
// owner/visibility — a category is "what area of the business is this
// about", not "who can see it".
enum ChecklistCategory {
  MARKETING
  SALES
  HR
  MANAGEMENT
}

// A running to-do list mixing recurring operating cadences (daily/weekly/
// monthly checks) with one-off and milestone items. Recurring tasks don't
// get a scheduled job to reset them — updatedAt is checked against the
// current day/week/month at read time (see effectiveChecklistStatus in
// lib/financials.ts), so a Daily task always reads as "Not Started" again
// once it was last touched outside today, with no cron involved.
model ChecklistTask {
  id          String              @id @default(cuid())
  frequency   ChecklistFrequency
  task        String
  owner       ChecklistOwner
  status      ChecklistTaskStatus @default(NOT_STARTED)
  completedAt DateTime?
  targetDate  DateTime?
  notes       String?             @db.Text
  visibility  ChecklistVisibility @default(OWNER_ONLY)
  category    ChecklistCategory   @default(MANAGEMENT)
  // Opt-in exception to the general Weekly-tasks-have-no-due-date rule (see
  // getEffectiveTargetDate in lib/checklistDisplay.ts) — for the rare weekly
  // task, like the Monday Team Update reminder, whose whole point IS a
  // Friday deadline. Left false for every other Weekly task.
  dueFridayOfWeek Boolean         @default(false)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

// A logged sales lead — table only for now. The full lead-capture form
// (under Sales), conversion tracking, and the KPI rollup feeding this
// dashboard are a separate, larger build to be scoped on its own.
model Lead {
  id           String   @id @default(cuid())
  date         DateTime
  clientName   String
  leadSource   String?
  clientType   String?
  converted    String?
  monthlyValue Float?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
}

enum LoanStatus {
  OPEN
  CLOSED
}

// A business loan/MCA/equipment-financing balance. currentBalance is
// entered/updated by the owner periodically (not reconstructed from a live
// payment ledger) — the expected payoff date is then estimated as
// currentBalance / minimumPayment periods, spaced by minimumPaymentFrequency
// (see estimateLoanPayoff in lib/loans.ts). For MCA-style loans repaid via a
// % holdback of daily sales, minimumPayment is only a contractual floor, so
// the real payoff is usually sooner than this estimate — never later.
model Loan {
  id                       String     @id @default(cuid())
  lender                   String
  loanType                 String? // e.g. "merchant_cash_advance", "equipment_installment"
  status                   LoanStatus @default(OPEN)
  originationDate          DateTime?
  closedDate               DateTime?
  loanAmount               Float?
  feeAmount                Float?
  totalToRepay             Float?
  repaymentRatePct         Float? // % of daily sales withheld — informational only
  minimumPayment           Float?
  minimumPaymentFrequency  String? // "monthly" | "every_60_days" | "weekly" | "daily"
  repaymentStartDate       DateTime?
  maturityDate             DateTime?
  priorLoanBalance         Float?
  netProceeds              Float?
  currentBalance           Float? // owner-entered, drives the payoff estimate
  currentBalanceAsOf       DateTime?
  notes                    String?    @db.Text
  order                    Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  repayments LoanRepayment[]
}

// Historical monthly repayment record, for reference — not used to derive
// currentBalance going forward (see the note on Loan above).
model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month           String // "2026-01"
  interestFeePaid Float?
  principalPaid   Float?
  totalPaid       Float
  createdAt       DateTime @default(now())

  @@unique([loanId, month])
}

enum WeeklyUpdateStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
}

// The weekly "Monday Team Update" posted to Slack. Filled out Thu/Fri for
// the coming Monday, reviewed/approved by anyone with Management edit
// access, then posted automatically at 8:05am Pacific the following Monday
// by the in-process scheduler (see instrumentation.ts) — regardless of
// exactly when during the week it was approved. formattedMessage is built
// once at save time (see formatWeeklyUpdate in lib/weeklyUpdate.ts) so the
// preview shown for approval is exactly what gets sent.
model WeeklyUpdate {
  id                   String             @id @default(cuid())
  weekOf               DateTime // the Monday this update is FOR
  spotlightName        String
  spotlightReason      String             @db.Text
  homesCleaned         Int
  commercialServiced   Int                @default(0)
  avgRating            Float
  clientShoutout       String?            @db.Text
  companyUpdates       String?            @db.Text
  weeklyGoal           String             @db.Text
  coreValue            String
  coreValueDescription String             @db.Text
  formattedMessage     String             @db.Text
  status               WeeklyUpdateStatus @default(DRAFT)
  createdById          String?
  createdBy            User?              @relation("WeeklyUpdateCreatedBy", fields: [createdById], references: [id])
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("WeeklyUpdateApprovedBy", fields: [approvedById], references: [id])
  sentAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([weekOf])
}

// ── HR Phase 1: Pair / Promotion / Milestone foundation ──
// A Field Team pairing: one Lead + one Assistant. Changing a pair logs a new
// row and closes out the old one (endDate + active:false) rather than
// overwriting it — HR needs pairing history, not just current state. At most
// one active pair per leadId and per assistantId is enforced with a partial
// unique index (see migration.sql), matching the "exactly one partner at a
// time" rule.
model Pair {
  id          String    @id @default(cuid())
  leadId      String
  lead        User      @relation("PairLead", fields: [leadId], references: [id], onDelete: Cascade)
  assistantId String
  assistant   User      @relation("PairAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("PairCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([assistantId])
}

enum PromotionTargetRole {
  ASSISTANT
  LEAD
  TRAINER
}

enum PromotionDecision {
  PROMOTE
  DEVELOP
  STAY
  ADDRESS
}

// Structured, queryable promotion pathway data (Assistant -> Lead -> Trainer)
// replacing what used to live only in Word documents. readinessIndicators is
// a JSON array of {label, met} pairs — the specific indicator text is a
// judgment call that will likely get revised after the first few promotions,
// so it's kept as editable app-config content (see READINESS_INDICATORS_BY_ROLE
// in src/lib/promotions.ts), not baked into separate DB columns.
// payDifferential is ADMIN-only — SERVICE_MANAGER should never see or set it
// even though the rest of the record is visible to them; enforced in the
// server action and stripped by serializePromotionAssessmentForRole before
// ever reaching a SERVICE_MANAGER's page. A CHECK constraint (see
// migration.sql) enforces that a DEVELOP decision always carries a
// development plan and a reassessment date.
model PromotionAssessment {
  id                  String              @id @default(cuid())
  employeeId          String
  employee            User               @relation("PromotionAssessmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  targetRole          PromotionTargetRole
  readinessIndicators Json
  decision            PromotionDecision
  developmentPlan     String?             @db.Text
  reassessmentDate    DateTime?
  payDifferential     Float?
  assessedById        String
  assessedBy          User                @relation("PromotionAssessmentAssessedBy", fields: [assessedById], references: [id])
  assessedAt           DateTime           @default(now())
  createdAt           DateTime            @default(now())

  linkedPaf PersonnelActionForm?

  @@index([employeeId])
}

enum PayReviewDecision {
  APPROVED
  DENIED
  DEFERRED
}

// A structured raise/pay-review record, mirroring PromotionAssessment —
// the assessment is the evaluation, and an Approved decision auto-generates
// a linked draft PAY_CHANGE PAF that actually authorizes payroll to act.
// ADMIN-only end to end (creation, viewing, deletion): unlike Promotion,
// there's no partial view for a SERVICE_MANAGER since every field here is
// comp data.
model PayReviewAssessment {
  id             String            @id @default(cuid())
  employeeId     String
  employee       User              @relation("PayReviewAssessmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  currentPay     Float
  recommendedPay Float
  justification  String            @db.Text
  decision       PayReviewDecision
  effectiveDate  DateTime?
  reviewedById   String
  reviewedBy     User              @relation("PayReviewAssessmentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  linkedPaf PersonnelActionForm?

  @@index([employeeId])
}

enum MilestoneCheckpoint {
  DAY_30
  DAY_60
  DAY_90
}

// 30/60/90-day milestone reviews. Due date is never stored — it's always
// computed at read time from the employee's real User.startDate (see
// getMilestoneDueDate in src/lib/milestones.ts), since a manually-typed
// tenure field is exactly what caused confusion in MCC's old spreadsheet.
// A row only exists once a review has actually been started/completed;
// "not started yet" for a checkpoint that's already due is computed by
// the absence of a row, not a stored status.
model MilestoneReview {
  id           String              @id @default(cuid())
  employeeId   String
  employee     User                @relation("MilestoneReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  checkpoint   MilestoneCheckpoint
  completedAt  DateTime?
  score        Int?
  notes        String?             @db.Text
  reviewedById String?
  reviewedBy   User?               @relation("MilestoneReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([employeeId, checkpoint])
}

// ── Personnel Action Form (PAF) ──
// The execution record for pay changes, transfers, title changes, and
// terminations — distinct from PromotionAssessment (the evaluation: "did
// they earn it, what's the evidence") in that a PAF is "what changed,
// effective when, approved by whom." Deciding a PromotionAssessment
// "Promote" auto-generates a linked draft PAF; a PAF can also stand alone
// for actions that never went through an assessment. Creating/approving a
// PAF is ADMIN-only — the record that actually authorizes payroll to act.
enum PafActionType {
  PROMOTION
  PAY_CHANGE
  TRANSFER
  TITLE_CHANGE
  TERMINATION
  OTHER
}

enum PafStatus {
  DRAFT
  APPROVED
  EXECUTED
}

model PersonnelActionForm {
  id                 String               @id @default(cuid())
  employeeId         String
  employee           User                 @relation("PafEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  actionType         PafActionType
  effectiveDate      DateTime
  priorTitle         String?
  newTitle           String?
  priorPay           Float?
  newPay             Float?
  priorDepartment    String?
  newDepartment      String?
  reason             String?              @db.Text
  linkedAssessmentId String?              @unique
  linkedAssessment   PromotionAssessment? @relation(fields: [linkedAssessmentId], references: [id], onDelete: SetNull)
  linkedPayReviewId  String?              @unique
  linkedPayReview    PayReviewAssessment? @relation(fields: [linkedPayReviewId], references: [id], onDelete: SetNull)
  status             PafStatus            @default(DRAFT)
  createdById        String
  createdBy          User                 @relation("PafCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?                @relation("PafApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([employeeId])
}
